{
    "manifest_version": 3,
    "name": "Web Developer Form Filler2",
    "version": "1.0.11",
    "description": "This extension is used by developers to make it easy to fill forms",
    "icons": {
        "16": "images/16.png",
        "48": "images/48.png",
        "128": "images/128.png"
    },
    "action": {
        "default_icon": "images/48.png",
        "default_title": "Web Developer Form Filler2",
        "default_popup": "popup.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "js": [
                "javascripts/jquery-1.9.1.min.js",
                "javascripts/deserialize.js",
                "javascripts/content_script.js",
                "javascripts/mousetrap.min.js"
            ],
            "matches": [ "http://*/*", "https://*/*", "file:///*" ],
            "run_at": "document_start"
        }
    ],
    "host_permissions": [
        "http://*/",
        "https://*/"
    ],
    "permissions": [
        "tabs"
    ]
}
